# Copia este archivo como .env y completa tus valores locales.
DB_URL=jdbc:mysql://localhost:3306/epcore_db?useSSL=false&serverTimezone=America/Bogota&allowPublicKeyRetrieval=true
DB_USERNAME=epcore_user
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_LOCAL
SERVER_PORT=8080

# Debe tener al menos 32 caracteres.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MS=28800000

# Opcional: crea un administrador inicial si la base de datos no tiene ese correo.
INITIAL_ADMIN_NAME=Administrador EPCORE
INITIAL_ADMIN_EMAIL=admin@epcore.com
INITIAL_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
